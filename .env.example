# ============================================
# vassal.ai — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Get your connection string from https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@your-db.neon.tech/vassal?sslmode=require"

# ============================================
# AUTHENTICATION
# ============================================
# JWT secret for session tokens — use a long random string (32+ chars)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ============================================
# OAUTH 2.0 (NextAuth.js)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this"

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Discord OAuth
# Get from: https://discord.com/developers
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ============================================
# WEBHOOKS
# ============================================
# Secret for verifying incoming webhook signatures (HMAC-SHA256)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET="your-webhook-signing-secret-change-this"

# ============================================
# WALLETCONNECT
# ============================================
# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# ============================================
# BLOCKCHAIN RPC
# ============================================
NEXT_PUBLIC_SOMNIA_RPC_URL="https://rpc.somnia.network"